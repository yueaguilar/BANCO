{
  "hosting": {
    "public": "FRONTEND/dist/FRONTEND/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
"headers": [
  {
    "source": "/index.html",
    "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
  },
  {
    "source": "**/*.@(js|css)",
    "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
  }
]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*"
      ]
    }
  ]
}